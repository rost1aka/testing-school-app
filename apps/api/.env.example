DATABASE_URL="postgresql://school:school@localhost:5432/school"
TEST_DATABASE_URL="postgresql://school:school@localhost:5432/school_test"
JWT_SECRET="dev-only-not-a-real-secret"
SMTP_HOST="localhost"
SMTP_PORT="1025"
APP_URL="http://localhost:3000"

# Optional. Set to "true" wherever the app is served over HTTPS, so the
# session cookies are issued Secure. Leave it unset locally: a Secure cookie
# is dropped over plain HTTP. This is what the Render deployment sets, because
# the web app proxies /api/* to the API and the cookies stay first-party.
# SECURE_COOKIES="true"

# Optional, and a last resort. Set to "true" only when the browser calls the
# API directly on a different site from the web app, which forces the session
# cookies to SameSite=None; Secure. That makes them *third-party* cookies,
# which Safari, every iOS browser, Brave, and any Chrome profile with
# third-party cookies blocked will refuse — sign-in then works on one machine
# and silently fails on the next. Proxy the API instead; see
# apps/web/next.config.ts.
# CROSS_SITE_COOKIES="true"

# Optional. Only needed for an SMTP server that requires credentials. Maildev
# accepts anonymous mail, so local development sets neither. With SMTP_HOST
# itself unset, no mail is sent at all and the reset link is logged instead.
# SMTP_USER=""
# SMTP_PASSWORD=""
