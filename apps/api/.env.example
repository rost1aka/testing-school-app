DATABASE_URL="postgresql://school:school@localhost:5432/school"
TEST_DATABASE_URL="postgresql://school:school@localhost:5432/school_test"
JWT_SECRET="dev-only-not-a-real-secret"
SMTP_HOST="localhost"
SMTP_PORT="1025"
APP_URL="http://localhost:3000"

# Optional. Set to "true" when the web app is served from a different site
# than the API — as it is on Render, where onrender.com is on the Public
# Suffix List — so the session cookies are issued SameSite=None; Secure.
# Leave it unset locally: a Secure cookie is dropped over plain HTTP.
# CROSS_SITE_COOKIES="true"

# Optional. Only needed for an SMTP server that requires credentials. Maildev
# accepts anonymous mail, so local development sets neither. With SMTP_HOST
# itself unset, no mail is sent at all and the reset link is logged instead.
# SMTP_USER=""
# SMTP_PASSWORD=""
